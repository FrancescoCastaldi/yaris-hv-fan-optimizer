<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Rigorosa disabilitazione di qualsiasi traffico cleartext/HTTP non crittografato -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
